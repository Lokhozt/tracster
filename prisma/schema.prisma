generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  OWNER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  firstName    String
  lastName     String
  phone        String?
  dateOfBirth  DateTime?
  role         UserRole @default(USER)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions                   Session[]
  createdChoreographies      Choreography[]              @relation("ChoreographyCreator")
  choreographyChoreographers ChoreographyChoreographer[]
  choreographyMembers        ChoreographyMember[]
  choreographyGroupMembers   ChoreographyGroupMember[]
  availabilityResponses      AvailabilityResponse[]
  createdRepetitionEvents    RepetitionEvent[]           @relation("RepetitionCreator")
  createdRepresentations     Representation[]            @relation("RepresentationCreator")
  createdEvents              Event[]                     @relation("EventCreator")
  eventParticipants          EventParticipant[]
  unavailabilityTimeframes   UserUnavailability[]
  choreographyJoinRequests   ChoreographyJoinRequest[]
  eventJoinRequests          EventJoinRequest[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Choreography {
  id                       String   @id @default(cuid())
  title                    String
  description              String?
  createdById              String
  allowParticipantJoin     Boolean  @default(false)
  allowJoinRequests        Boolean  @default(false)
  hideFromNonParticipants  Boolean  @default(true)
  archivedAt               DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  createdBy       User                         @relation("ChoreographyCreator", fields: [createdById], references: [id])
  choreographers  ChoreographyChoreographer[]
  members         ChoreographyMember[]
  groups          ChoreographyGroup[]
  repetitions     RepetitionEvent[]
  representations ChoreographyRepresentation[]
  joinRequests    ChoreographyJoinRequest[]
}

model ChoreographyChoreographer {
  choreographyId String
  userId         String
  assignedAt     DateTime @default(now())

  choreography Choreography @relation(fields: [choreographyId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([choreographyId, userId])
}

model ChoreographyJoinRequest {
  choreographyId String
  userId         String
  requestedAt    DateTime @default(now())

  choreography Choreography @relation(fields: [choreographyId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([choreographyId, userId])
  @@index([choreographyId])
}

model ChoreographyMember {
  choreographyId String
  userId         String
  assignedAt     DateTime @default(now())

  choreography Choreography @relation(fields: [choreographyId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([choreographyId, userId])
}

model ChoreographyGroup {
  id             String   @id @default(cuid())
  choreographyId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  choreography Choreography              @relation(fields: [choreographyId], references: [id], onDelete: Cascade)
  members      ChoreographyGroupMember[]
  repetitions  RepetitionEvent[]

  @@index([choreographyId])
}

model ChoreographyGroupMember {
  groupId    String
  userId     String
  assignedAt DateTime @default(now())

  group ChoreographyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model RepetitionEvent {
  id             String    @id @default(cuid())
  choreographyId String
  groupId        String?
  title          String?
  startsAt       DateTime
  endsAt         DateTime?
  location       String?
  notes          String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  choreography   Choreography           @relation(fields: [choreographyId], references: [id], onDelete: Cascade)
  group          ChoreographyGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy      User                   @relation("RepetitionCreator", fields: [createdById], references: [id])
  availabilities AvailabilityResponse[]
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  MAYBE
}

model AvailabilityResponse {
  id                String             @id @default(cuid())
  repetitionEventId String
  userId            String
  status            AvailabilityStatus
  respondedAt       DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  repetitionEvent RepetitionEvent @relation(fields: [repetitionEventId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repetitionEventId, userId])
}

model Representation {
  id          String    @id @default(cuid())
  title       String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  notes       String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy      User                         @relation("RepresentationCreator", fields: [createdById], references: [id])
  choreographies ChoreographyRepresentation[]
}

model ChoreographyRepresentation {
  choreographyId   String
  representationId String
  assignedAt       DateTime @default(now())

  choreography   Choreography   @relation(fields: [choreographyId], references: [id], onDelete: Cascade)
  representation Representation @relation(fields: [representationId], references: [id], onDelete: Cascade)

  @@id([choreographyId, representationId])
}

model Event {
  id                      String    @id @default(cuid())
  title                   String
  description             String?
  startsAt                DateTime
  endsAt                  DateTime?
  location                String?
  createdById             String
  allowParticipantJoin    Boolean   @default(false)
  allowJoinRequests       Boolean   @default(false)
  hideFromNonParticipants Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  createdBy    User               @relation("EventCreator", fields: [createdById], references: [id])
  participants EventParticipant[]
  joinRequests EventJoinRequest[]
}

model EventJoinRequest {
  eventId     String
  userId      String
  requestedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([eventId])
}

model EventParticipant {
  eventId    String
  userId     String
  assignedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

model UserUnavailability {
  id        String   @id @default(cuid())
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
}

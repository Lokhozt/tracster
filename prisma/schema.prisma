generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  OWNER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  firstName    String
  lastName     String
  phone        String?
  dateOfBirth  DateTime?
  role         UserRole @default(USER)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions                   Session[]
  createdChoreographies      Choreography[]              @relation("ChoreographyCreator")
  choreographyChoreographers ChoreographyChoreographer[]
  choreographyMembers        ChoreographyMember[]
  choreographyGroupMembers   ChoreographyGroupMember[]
  availabilityResponses      AvailabilityResponse[]
  createdEvents              Event[]                     @relation("EventCreator")
  eventParticipants          EventParticipant[]
  unavailabilityTimeframes   UserUnavailability[]
  choreographyJoinRequests   ChoreographyJoinRequest[]
  eventJoinRequests          EventJoinRequest[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Choreography {
  id                       String   @id @default(cuid())
  title                    String
  description              String?
  createdById              String
  allowParticipantJoin     Boolean  @default(false)
  allowJoinRequests        Boolean  @default(false)
  hideFromNonParticipants  Boolean  @default(true)
  archivedAt               DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  createdBy       User                         @relation("ChoreographyCreator", fields: [createdById], references: [id])
  choreographers  ChoreographyChoreographer[]
  members         ChoreographyMember[]
  groups          ChoreographyGroup[]
  repetitions     Event[]                    @relation("EventRepetitionChoreography")
  eventLinks      EventChoreography[]
  joinRequests    ChoreographyJoinRequest[]
}

model ChoreographyChoreographer {
  choreographyId String
  userId         String
  assignedAt     DateTime @default(now())

  choreography Choreography @relation(fields: [choreographyId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([choreographyId, userId])
}

model ChoreographyJoinRequest {
  choreographyId String
  userId         String
  requestedAt    DateTime @default(now())

  choreography Choreography @relation(fields: [choreographyId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([choreographyId, userId])
  @@index([choreographyId])
}

model ChoreographyMember {
  choreographyId String
  userId         String
  assignedAt     DateTime @default(now())

  choreography Choreography @relation(fields: [choreographyId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([choreographyId, userId])
}

model ChoreographyGroup {
  id             String   @id @default(cuid())
  choreographyId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  choreography Choreography              @relation(fields: [choreographyId], references: [id], onDelete: Cascade)
  members      ChoreographyGroupMember[]
  repetitions  Event[]

  @@index([choreographyId])
}

model ChoreographyGroupMember {
  groupId    String
  userId     String
  assignedAt DateTime @default(now())

  group ChoreographyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model Location {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@unique([name])
}

model SiteSettings {
  id                            String   @id
  allowUserCreateChoreographies Boolean  @default(true)
  allowUserCreateEvents         Boolean  @default(true)
  startOfDayHour                Int      @default(8)
  updatedAt                     DateTime @updatedAt
}

enum EventKind {
  EVENT
  REPETITION
  REPRESENTATION
  COMPETITION
  DEMONSTRATION
}

model EventType {
  id         String     @id @default(cuid())
  name       String     @unique
  kind       EventKind? @unique
  immutable  Boolean    @default(false)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  events Event[]
}

model Event {
  id                      String    @id @default(cuid())
  typeId                  String
  title                   String    @default("")
  description             String?
  notes                   String?
  startsAt                DateTime
  endsAt                  DateTime?
  locationId              String?
  location                String?
  createdById             String
  allowParticipantJoin    Boolean   @default(false)
  allowJoinRequests       Boolean   @default(false)
  hideFromNonParticipants Boolean   @default(true)
  choreographyId          String?
  groupId                 String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  type           EventType              @relation(fields: [typeId], references: [id])
  listedLocation Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy      User                   @relation("EventCreator", fields: [createdById], references: [id])
  choreography   Choreography?          @relation("EventRepetitionChoreography", fields: [choreographyId], references: [id], onDelete: Cascade)
  group          ChoreographyGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  choreographies EventChoreography[]
  participants   EventParticipant[]
  joinRequests   EventJoinRequest[]
  availabilities AvailabilityResponse[]

  @@index([typeId])
  @@index([locationId])
  @@index([choreographyId])
  @@index([groupId])
}

model EventChoreography {
  eventId        String
  choreographyId String
  assignedAt     DateTime @default(now())

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  choreography Choreography @relation(fields: [choreographyId], references: [id], onDelete: Cascade)

  @@id([eventId, choreographyId])
  @@index([choreographyId])
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  MAYBE
}

model AvailabilityResponse {
  id          String             @id @default(cuid())
  eventId     String
  userId      String
  status      AvailabilityStatus
  respondedAt DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventJoinRequest {
  eventId     String
  userId      String
  requestedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([eventId])
}

model EventParticipant {
  eventId    String
  userId     String
  assignedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

model UserUnavailability {
  id        String   @id @default(cuid())
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
}

DATABASE_URL="postgresql://tracster:tracster@localhost:5432/tracster"
SESSION_SECRET="change-me-in-production-use-a-long-random-string"
# Optional. When set, registration asks for this password before the account form.
REGISTERING_PASSWORD=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public product name (header, page title, in-app copy). Defaults to Tracster if unset.
NEXT_PUBLIC_APP_NAME="TRACker"
DEFAULT_LANGUAGE="french"
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_ASSOCIATION_CALENDAR_ID=""
GOOGLE_ASSOCIATION_CALENDAR_TIMEZONE="Europe/Paris"

# Railway Storage Bucket (S3-compatible). On Railway, insert the AWS SDK variable
# preset from the bucket, or reference it:
# Choreography resource uploads use presigned browser requests. Configure bucket CORS
# to allow this app's origin with PUT, GET, and HEAD methods and Content-Type.
# AWS_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
# AWS_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
# AWS_ENDPOINT_URL=${{Bucket.ENDPOINT}}
# AWS_S3_BUCKET_NAME=${{Bucket.BUCKET}}
# AWS_DEFAULT_REGION=${{Bucket.REGION}}
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL="https://storage.railway.app"
AWS_S3_BUCKET_NAME=""
AWS_DEFAULT_REGION="auto"
# AWS_S3_URL_STYLE="virtual"
